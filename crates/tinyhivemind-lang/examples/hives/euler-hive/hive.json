  "desks": [
    {
      "id": "research",
      "name": "Research",
      "description": "Find the theory and literature the problem rests on; report sources, never a copied answer",
      "members": [
        "research-librarian",
        "research-provenance",
        "research-scout"
      ],
      "responder_mode": "auto"
    },
    {
      "id": "theory",
      "name": "Theory",
      "description": "Identify the combinatorial structure, prove what it forces, and turn it into a checkable plan",
      "members": [
        "theory-designer",
        "theory-coder",
        "theory-counter"
      ],
      "responder_mode": "auto"
    },
    {
      "id": "compute",
      "name": "Compute",
      "description": "Turn the plan into exact programs, run them in the sandbox, and report outputs verbatim",
      "members": [
        "compute-exhaustive",
        "compute-linear",
        "compute-minimalist"
      ],
      "responder_mode": "auto"
    },
    {
      "id": "verify",
      "name": "Verify",
      "description": "Re-derive every candidate independently and check it against each stated constraint",
      "members": [
        "verify-constraints",
        "verify-rederiver",
        "verify-adversary"
      ],
      "responder_mode": "auto"
    },
    {
      "id": "synthesis",
      "name": "Synthesis",
      "description": "Commit the hive's answer once verification has signed it off",
      "members": [
        "synthesis-judge",
        "synthesis-dissent"
      ],
      "responder_mode": "auto"
    }
  ],
  "goals": [
    {
      "id": "answer",
      "description": "Commit the exact answer to the problem in context/problem.md, in the format it asks for",
      "acceptance": [
        "Signed off by the verify desk with sandbox output",
        "Every stated constraint checked separately"
      ],
      "subgoals": [
        "structure",
        "candidate"
      ]
    },
    {
      "id": "structure",
      "description": "Identify the structure the problem describes and what determines the answer",
      "acceptance": [
        "Cites at least one source or a derivation"
      ],
      "subgoals": []
    },
    {
      "id": "candidate",
      "description": "Compute a candidate answer exactly in the sandbox",
      "acceptance": [
        "Printed by a program the hive ran"
      ],
      "subgoals": []
    }
  ],
  "missions": [
    {
      "id": "survey",
      "role": "researcher",
      "goals": [
        "structure"
      ]
    },
    {
      "id": "derive",
      "role": "theorist",
      "goals": [
        "structure"
      ]
    },
    {
      "id": "compute",
      "role": "computer",
      "goals": [
        "candidate"
      ]
    },
    {
      "id": "check",
      "role": "verifier",
      "goals": [
        "answer"
      ]
    },
    {
      "id": "commit",
      "role": "synthesizer",
      "goals": [
        "answer"
      ]
    }
  ],
  "topology": [
    {
      "from": "research",
