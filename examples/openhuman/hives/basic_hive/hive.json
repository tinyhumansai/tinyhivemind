{
  "$schema": "https://tinyhumans.ai/schemas/hive/v1",
  "version": 1,
  "id": "release",
  "name": "Release",
  "seats": [
    {
      "id": "alice",
      "role": "planner",
      "prompt": "seats/alice.md",
      "template": "openhuman"
    },
    {
      "id": "bob",
      "role": "reviewer",
      "prompt": "seats/bob.md",
      "template": "openhuman"
    }
  ],
  "desks": [
    {
      "id": "release",
      "name": "Release",
      "members": [
        "alice",
        "bob"
      ]
    }
  ],
  "policies": {
    "routing": {
      "minimum_confidence": 600000,
      "high_impact_minimum_confidence": 800000,
      "clarification_threshold": 700000,
      "high_impact_threshold": 700000,
      "round_width": 4,
      "choice_option_limit": 8
    }
  },
  "runtime": {
    "deployment_id": "default",
    "autonomy": "read_only"
  },
  "roles": [
    {
      "id": "planner",
      "charter": "roles/planner.md"
    },
    {
      "id": "reviewer",
      "charter": "roles/reviewer.md"
    }
  ]
}
